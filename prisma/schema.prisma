// prisma/schema.prisma
// ─────────────────────────────────────────────────────────────────────────────
// Prisma data model for the Nutri-Diet multi-tenant SaaS platform.
// Phase 1 + 2: Tenant, User, Client, RefreshToken.
//
// Rules enforced here:
//  - Every entity has a UUID primary key (cuid() used for URL-safety + performance)
//  - Every entity that belongs to a tenant carries a tenantId FK
//  - Soft-delete via deletedAt (no hard deletes on business data)
//  - Timestamps (createdAt, updatedAt) on every table
//  - All string IDs are generated server-side — never trust client-supplied IDs
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum WhatsAppConnectionStatus {
  NOT_CONFIGURED
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

enum Role {
  OWNER
  ADMIN
  DIETITIAN
  ASSISTANT
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

enum AssessmentSectionType {
  ANTHROPOMETRICS
  MEDICAL
  LIFESTYLE
  LABS
}

enum AssessmentSectionWorkflowStatus {
  DRAFT
  COMPLETED
}

enum ClientGoalType {
  WEIGHT_LOSS
  WEIGHT_GAIN
  MAINTENANCE
  MUSCLE_GAIN
  PERFORMANCE
  MEDICAL_NUTRITION
  GENERAL_WELLNESS
  CUSTOM
}

enum ClientGoalStatus {
  ACTIVE
  COMPLETED
  SUPERSEDED
  CANCELLED
}

enum LabResultSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskFlagSeverity {
  INFO
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskFlagStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ReminderJobType {
  MEAL_REMINDER
  MEAL_FOLLOWUP
  WATER_REMINDER
  SLEEP_REMINDER
}

enum ReminderJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// Top-level multi-tenancy entity. Every business (clinic, coach, dietitian)
// is a Tenant. All data queries MUST include tenantId in the WHERE clause.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  plan   TenantPlan   @default(FREE)
  status TenantStatus @default(TRIAL)

  // Optional contact info
  email             String?
  phone             String?
  address           String?
  logoUrl           String?
  themeId           String?
  countryCode       String?
  timezone          String            @default("UTC")
  locale            String            @default("en-US")
  currencyCode      String            @default("USD")
  measurementSystem MeasurementSystem @default(METRIC)
  pdfTemplateConfig Json?

  // Practice branding fields
  practiceEmail     String?
  practicePhone     String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  country           String?
  postalCode        String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users                       User[]
  clients                     Client[]
  assessments                 Assessment[]
  dietPlans                   DietPlan[]
  foodLibrary                 FoodLibrary[]
  dietPlanTemplates           DietPlanTemplate[]
  clientCheckIns              ClientCheckIn[]
  foodCategories              FoodCategory[]
  foodTags                    FoodTag[]
  mealSwapHistories           MealSwapHistory[]
  clientClinicalProfiles      ClientClinicalProfile[]
  assessmentSectionStatuses   AssessmentSectionStatus[]
  clientAnthropometricRecords ClientAnthropometricRecord[]
  clientConditions            ClientCondition[]
  clientAllergies             ClientAllergy[]
  clientMedications           ClientMedication[]
  clientSupplements           ClientSupplement[]
  clientDigestiveIssues       ClientDigestiveIssue[]
  clientLifestyleProfiles     ClientLifestyleProfile[]
  clientGoalProfiles          ClientGoalProfile[]
  labMarkerDefinitions        LabMarkerDefinition[]
  clientLabResults            ClientLabResult[]
  clientRiskFlags             ClientRiskFlag[]
  assessmentSnapshots         AssessmentSnapshot[]
  fileAssets                  FileAsset[]
  vaultDocuments              VaultDocument[]
  whatsAppConnection          WhatsAppConnection?
  whatsAppConversations       WhatsAppConversation[]
  whatsAppMessages            WhatsAppMessage[]
  notifications               Notification[]
  dietPlanAutomations         DietPlanAutomation[]
  reminderJobs                ReminderJob[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Platform users (staff side): OWNER, ADMIN, DIETITIAN, ASSISTANT.
// CLIENT role users have a corresponding Client record.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(DIETITIAN)
  status       UserStatus @default(PENDING)
  phone        String?
  avatarUrl    String?

  // Security
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant                       Tenant                    @relation(fields: [tenantId], references: [id])
  clients                      Client[]                  @relation("AssignedDietitian")
  refreshTokens                RefreshToken[]
  assessments                  Assessment[]
  dietPlans                    DietPlan[]
  dietPlanTemplates            DietPlanTemplate[]
  reviewedCheckIns             ClientCheckIn[]
  mealSwapHistories            MealSwapHistory[]
  createdClinicalProfiles      ClientClinicalProfile[]   @relation("ClinicalProfileCreator")
  completedAssessmentSections  AssessmentSectionStatus[] @relation("AssessmentSectionCompletedBy")
  generatedRiskFlags           ClientRiskFlag[]          @relation("RiskFlagGenerator")
  generatedAssessmentSnapshots AssessmentSnapshot[]      @relation("AssessmentSnapshotGenerator")
  uploadedFiles                FileAsset[]               @relation("FileUploader")
  whatsAppMessages             WhatsAppMessage[]
  notifications                Notification[]
  notificationPreference       NotificationPreference?

  // Compound unique: email must be unique within a tenant (not globally)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT
// End-users of the wellness service. Can have a linked User account (for
// portal access) or exist as a practitioner-managed record only.
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id          String  @id @default(cuid())
  tenantId    String
  dietitianId String? // Assigned practitioner (User with DIETITIAN role)

  // Identity
  firstName     String
  lastName      String
  email         String?
  phone         String?
  gender        Gender?
  dateOfBirth   DateTime?
  avatarAssetId String?

  // Health context (non-PHI; PHI goes in a separate encrypted table in Phase 2)
  notes String?

  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?          // ISO alpha-2 e.g. "IN"
  timezone         String?
  locale           String?
  remindersEnabled Boolean          @default(true)

  status           ClientStatus     @default(ACTIVE)
  onboardingStatus OnboardingStatus @default(PENDING)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant                    Tenant                       @relation(fields: [tenantId], references: [id])
  dietitian                 User?                        @relation("AssignedDietitian", fields: [dietitianId], references: [id])
  avatarAsset               FileAsset?                   @relation("ClientAvatar", fields: [avatarAssetId], references: [id])
  assessments               Assessment[]
  dietPlans                 DietPlan[]
  checkIns                  ClientCheckIn[]
  clinicalProfile           ClientClinicalProfile?
  assessmentSectionStatuses AssessmentSectionStatus[]
  anthropometricRecords     ClientAnthropometricRecord[]
  conditions                ClientCondition[]
  allergyRecords            ClientAllergy[]
  medicationRecords         ClientMedication[]
  supplementRecords         ClientSupplement[]
  digestiveIssueRecords     ClientDigestiveIssue[]
  lifestyleProfile          ClientLifestyleProfile?
  goalProfiles              ClientGoalProfile[]
  labResults                ClientLabResult[]
  riskFlags                 ClientRiskFlag[]
  assessmentSnapshots       AssessmentSnapshot[]
  vaultDocuments            VaultDocument[]
  whatsAppConversations     WhatsAppConversation[]
  dietPlanAutomations       DietPlanAutomation[]
  reminderJobs              ReminderJob[]

  @@index([tenantId])
  @@index([tenantId, dietitianId])
  @@index([tenantId, email])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFRESH TOKEN
// Stores hashed refresh tokens for secure rotation.
// Raw token is sent to client; only SHA-256 hash lives in DB.
// Token reuse triggers immediate revocation of all user sessions.
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256(rawToken) — NEVER the raw token
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT
// Clinical assessment records.
// ─────────────────────────────────────────────────────────────────────────────

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

model Assessment {
  id        String @id @default(cuid())
  tenantId  String
  clientId  String
  createdBy String

  title          String
  assessmentDate DateTime

  heightCm Float?
  weightKg Float?
  bmi      Float?

  goal     String?
  goalType ClientGoalType?

  activityLevel     ActivityLevel?
  waterIntakeLiters Float?

  sleepHours Float?

  medicalConditions String?
  allergies         String?
  medications       String?

  foodPreferences  String?
  foodRestrictions String?

  notes String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  client                Client                       @relation(fields: [clientId], references: [id])
  creator               User                         @relation(fields: [createdBy], references: [id])
  dietPlans             DietPlan[]
  clinicalProfiles      ClientClinicalProfile[]      @relation("LatestAssessmentProfile")
  sectionStatuses       AssessmentSectionStatus[]
  anthropometricRecords ClientAnthropometricRecord[]
  conditions            ClientCondition[]
  allergyRecords        ClientAllergy[]
  medicationRecords     ClientMedication[]
  supplementRecords     ClientSupplement[]
  digestiveIssueRecords ClientDigestiveIssue[]
  lifestyleProfiles     ClientLifestyleProfile[]
  goalProfiles          ClientGoalProfile[]
  labResults            ClientLabResult[]
  riskFlags             ClientRiskFlag[]
  snapshots             AssessmentSnapshot[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("assessments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ASSESSMENT V2 FOUNDATION
// Client-owned clinical intake foundation. Existing Assessment remains the
// backward-compatible intake summary and diet plan reference.
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ClientClinicalProfile {
  id                 String    @id @default(cuid())
  tenantId           String
  clientId           String    @unique
  latestAssessmentId String?
  createdById        String?
  summaryNotes       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  client                Client                       @relation(fields: [clientId], references: [id])
  latestAssessment      Assessment?                  @relation("LatestAssessmentProfile", fields: [latestAssessmentId], references: [id], onDelete: SetNull)
  createdBy             User?                        @relation("ClinicalProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sectionStatuses       AssessmentSectionStatus[]
  anthropometricRecords ClientAnthropometricRecord[]
  conditions            ClientCondition[]
  allergies             ClientAllergy[]
  medications           ClientMedication[]
  supplements           ClientSupplement[]
  digestiveIssues       ClientDigestiveIssue[]
  lifestyleProfile      ClientLifestyleProfile?
  goalProfiles          ClientGoalProfile[]
  labResults            ClientLabResult[]
  riskFlags             ClientRiskFlag[]
  snapshots             AssessmentSnapshot[]

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@index([latestAssessmentId])
  @@map("client_clinical_profiles")
}

model AssessmentSectionStatus {
  id            String                          @id @default(cuid())
  tenantId      String
  clientId      String
  profileId     String
  assessmentId  String?
  section       AssessmentSectionType
  status        AssessmentSectionWorkflowStatus @default(DRAFT)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  deletedAt     DateTime?

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  client      Client                @relation(fields: [clientId], references: [id])
  profile     ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment  Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  completedBy User?                 @relation("AssessmentSectionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, profileId, section])
  @@index([tenantId, clientId])
  @@index([assessmentId])
  @@map("assessment_section_statuses")
}

model ClientAnthropometricRecord {
  id             String    @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  measuredAt     DateTime  @default(now())
  heightCm       Float?
  weightKg       Float?
  bmi            Float?
  bodyFatPercent Float?
  leanMassKg     Float?
  waistCm        Float?
  hipCm          Float?
  chestCm        Float?
  armCm          Float?
  thighCm        Float?
  neckCm         Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@index([measuredAt])
  @@map("client_anthropometric_records")
}

model ClientCondition {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  status       String?
  diagnosedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_conditions")
}

model ClientAllergy {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  allergen     String
  reaction     String?
  severity     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, allergen])
  @@index([profileId])
  @@map("client_allergies")
}

model ClientMedication {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  dosage       String?
  frequency    String?
  startedAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_medications")
}

model ClientSupplement {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  dosage       String?
  frequency    String?
  startedAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_supplements")
}

model ClientDigestiveIssue {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  severity     String?
  triggers     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_digestive_issues")
}

model ClientLifestyleProfile {
  id                String         @id @default(cuid())
  tenantId          String
  clientId          String         @unique
  profileId         String         @unique
  assessmentId      String?
  occupation        String?
  workSchedule      String?
  sleepHours        Float?
  stressLevel       Int?
  hydrationLiters   Float?
  trainingFrequency String?
  activityLevel     ActivityLevel?
  mealTiming        String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId])
  @@index([tenantId, clientId])
  @@index([assessmentId])
  @@map("client_lifestyle_profiles")
}

model ClientGoalProfile {
  id             String           @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  goalType       ClientGoalType
  targetWeightKg Float?
  targetDate     DateTime?
  status         ClientGoalStatus @default(ACTIVE)
  notes          String?
  versionNumber  Int              @default(1)
  startedAt      DateTime         @default(now())
  endedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  client     Client                @relation(fields: [clientId], references: [id])
  profile    ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  dietPlans  DietPlan[]

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([status])
  @@map("client_goal_profiles")
}

model LabMarkerDefinition {
  id             String    @id @default(cuid())
  tenantId       String?
  markerKey      String
  name           String
  category       String?
  defaultUnit    String?
  referenceRange Json?
  sortOrder      Int       @default(1)
  isSystem       Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  labResults ClientLabResult[]

  @@unique([tenantId, markerKey])
  @@index([tenantId])
  @@index([markerKey])
  @@index([isSystem, isActive])
  @@map("lab_marker_definitions")
}

model ClientLabResult {
  id                     String             @id @default(cuid())
  tenantId               String
  clientId               String
  profileId              String
  assessmentId           String?
  markerDefinitionId     String?
  markerKey              String
  markerName             String
  valueNumeric           Float?
  valueText              String?
  unit                   String?
  collectedDate          DateTime?
  resultDate             DateTime?
  referenceRangeSnapshot Json?
  isAbnormal             Boolean            @default(false)
  severity               LabResultSeverity?
  flagReason             String?
  source                 String?
  notes                  String?
  metadata               Json?
  vaultDocumentId        String?
  documentPageReference  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  client           Client                @relation(fields: [clientId], references: [id])
  profile          ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment       Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  markerDefinition LabMarkerDefinition?  @relation(fields: [markerDefinitionId], references: [id], onDelete: SetNull)
  vaultDocument    VaultDocument?        @relation(fields: [vaultDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@index([markerDefinitionId])
  @@index([markerKey])
  @@index([resultDate])
  @@index([isAbnormal])
  @@index([vaultDocumentId])
  @@map("client_lab_results")
}

model ClientRiskFlag {
  id             String           @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  flagType       String
  severity       RiskFlagSeverity
  reason         String
  sourceDomain   String?
  sourceRecordId String?
  status         RiskFlagStatus   @default(ACTIVE)
  generatedById  String?
  generatedAt    DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  client      Client                @relation(fields: [clientId], references: [id])
  profile     ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment  Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  generatedBy User?                 @relation("RiskFlagGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([status])
  @@index([severity])
  @@index([sourceDomain, sourceRecordId])
  @@map("client_risk_flags")
}

model AssessmentSnapshot {
  id              String    @id @default(cuid())
  tenantId        String
  clientId        String
  profileId       String
  assessmentId    String?
  version         Int
  snapshot        Json
  sourceUpdatedAt DateTime?
  generatedById   String?
  generatedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  client      Client                @relation(fields: [clientId], references: [id])
  profile     ClientClinicalProfile @relation(fields: [profileId], references: [id])
  assessment  Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  generatedBy User?                 @relation("AssessmentSnapshotGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId, version])
  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@map("assessment_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIET PLAN
// ─────────────────────────────────────────────────────────────────────────────

enum DietPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MealType {
  BREAKFAST
  MID_MORNING
  LUNCH
  EVENING_SNACK
  DINNER
  BEDTIME
}

model DietPlan {
  id           String  @id @default(cuid())
  tenantId     String
  clientId     String
  assessmentId String?

  title         String
  description   String?
  goalProfileId String?

  dailyCalories Int?
  proteinGrams  Float?
  carbGrams     Float?
  fatGrams      Float?

  // Aggregated macros
  totalCalories Int   @default(0)
  totalProtein  Float @default(0)
  totalCarbs    Float @default(0)
  totalFat      Float @default(0)

  // Data Sections (HTML content from RichTextEditor)
  instructions       String? @db.Text
  recommendations    String? @db.Text
  lifestyleAdvice    String? @db.Text
  hydration          String? @db.Text
  supplementNotes    String? @db.Text
  mealPrepNotes      String? @db.Text

  // Versioning
  versionNumber Int @default(1)

  startDate DateTime?
  endDate   DateTime?

  status DietPlanStatus @default(DRAFT)

  createdBy      String
  cycleStartDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  client      Client             @relation(fields: [clientId], references: [id])
  assessment  Assessment?        @relation(fields: [assessmentId], references: [id])
  goalProfile ClientGoalProfile? @relation(fields: [goalProfileId], references: [id])
  creator     User               @relation(fields: [createdBy], references: [id])
  meals       DietPlanMeal[]
  checkIns    ClientCheckIn[]
  cycles      DietPlanCycle[]
  automations DietPlanAutomation[]
  reminderJobs ReminderJob[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("diet_plans")
}

model DietPlanMeal {
  id         String   @id @default(cuid())
  dietPlanId String
  name       MealType
  mealOrder  Int
  mealTime   String?
  notes      String?
  cycleDayId String?

  // Relations
  dietPlan DietPlan           @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  cycleDay DietPlanCycleDay?  @relation(fields: [cycleDayId], references: [id], onDelete: Cascade)
  items    DietPlanMealItem[]

  @@index([dietPlanId])
  @@index([cycleDayId])
  @@map("diet_plan_meals")
}

model DietPlanMealItem {
  id            String         @id @default(cuid())
  mealId        String
  foodLibraryId String?
  foodName      String
  sourceType    FoodSourceType @default(CUSTOM)
  quantity      Float
  unit          String
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  notes         String?

  // Relations
  meal        DietPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLibrary FoodLibrary? @relation(fields: [foodLibraryId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([foodLibraryId])
  @@map("diet_plan_meal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// FOOD LIBRARY
// ─────────────────────────────────────────────────────────────────────────────

enum FoodSourceType {
  CUSTOM
  SYSTEM
}

model FoodLibrary {
  id              String     @id @default(cuid())
  tenantId        String
  foodName        String
  isSystem        Boolean    @default(false)
  defaultQuantity Float
  defaultUnit     String
  servingSize     Float
  servingUnit     String
  calories        Float?
  protein         Float?
  carbs           Float?
  fat             Float?
  categoryId      String?
  searchKeywords  String?
  commonName      String?
  brandName       String?
  status          FoodStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  // Relations
  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  mealItems         DietPlanMealItem[]
  templateMealItems DietPlanTemplateMealItem[]
  category          FoodCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagMappings       FoodTagMapping[]
  servings          FoodServing[]
  sourceEquivalents FoodEquivalent[]           @relation("SourceEquivalent")
  targetEquivalents FoodEquivalent[]           @relation("TargetEquivalent")
  originalFoodSwaps MealSwapHistory[]          @relation("OriginalFoodSwaps")
  targetFoodSwaps   MealSwapHistory[]          @relation("TargetFoodSwaps")

  @@index([tenantId])
  @@index([tenantId, foodName])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("food_library")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIET PLAN TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model DietPlanTemplate {
  id            String          @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  goalType      ClientGoalType?
  dailyCalories Int?
  proteinGrams  Float?
  carbGrams     Float?
  fatGrams      Float?

  // Aggregated macros
  totalCalories Int   @default(0)
  totalProtein  Float @default(0)
  totalCarbs    Float @default(0)
  totalFat      Float @default(0)

  // Data Sections (HTML content from RichTextEditor)
  instructions       String? @db.Text
  recommendations    String? @db.Text
  lifestyleAdvice    String? @db.Text
  hydration          String? @db.Text
  supplementNotes    String? @db.Text
  mealPrepNotes      String? @db.Text

  isPublic  Boolean   @default(false)
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  creator  User                   @relation(fields: [createdBy], references: [id])
  meals    DietPlanTemplateMeal[]
  cycles   TemplateCycle[]

  @@index([tenantId])
  @@map("diet_plan_templates")
}

model DietPlanTemplateMeal {
  id         String   @id @default(cuid())
  templateId String
  name       MealType
  mealOrder  Int
  mealTime   String?
  notes      String?
  cycleDayId String?

  // Relations
  template DietPlanTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cycleDay TemplateCycleDay?          @relation(fields: [cycleDayId], references: [id], onDelete: Cascade)
  items    DietPlanTemplateMealItem[]

  @@index([templateId])
  @@index([cycleDayId])
  @@map("diet_plan_template_meals")
}

model DietPlanTemplateMealItem {
  id            String         @id @default(cuid())
  mealId        String
  foodLibraryId String?
  foodName      String
  sourceType    FoodSourceType @default(CUSTOM)
  quantity      Float
  unit          String
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  notes         String?

  // Relations
  meal        DietPlanTemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLibrary FoodLibrary?         @relation(fields: [foodLibraryId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([foodLibraryId])
  @@map("diet_plan_template_meal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT CHECK-INS
// ─────────────────────────────────────────────────────────────────────────────

enum CheckInStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

model ClientCheckIn {
  id         String  @id @default(cuid())
  tenantId   String
  clientId   String
  dietPlanId String?

  checkInDate DateTime
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?

  status           CheckInStatus @default(PENDING)
  requiresFollowUp Boolean       @default(false)

  // Weight & Measurements
  weightKg Float?
  waistCm  Float?
  hipCm    Float?
  chestCm  Float?
  armCm    Float?
  thighCm  Float?

  // Lifestyle
  waterIntakeLiters Float?
  sleepHours        Float?
  exerciseDays      Int?

  // Self Assessment
  energyLevel    Int?
  stressLevel    Int?
  moodLevel      Int?
  planAdherence  Int?
  adherenceNotes String?

  // Notes
  clientNotes       String?
  practitionerNotes String?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  dietPlan DietPlan? @relation(fields: [dietPlanId], references: [id], onDelete: SetNull)
  reviewer User?     @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
  @@index([status])
  @@index([submittedAt])
  @@index([checkInDate])
  @@index([clientId, checkInDate])
  @@map("client_check_ins")
}

model DietPlanCycle {
  id          String   @id @default(cuid())
  dietPlanId  String
  name        String
  description String?
  startDay    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  dietPlan DietPlan           @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  days     DietPlanCycleDay[]

  @@index([dietPlanId])
  @@map("diet_plan_cycles")
}

model DietPlanCycleDay {
  id              String  @id @default(cuid())
  cycleId         String
  dayNumber       Int
  dayLabel        String
  description     String?
  isActive        Boolean @default(true)
  plannedCalories Int     @default(0)
  plannedProtein  Float   @default(0)
  plannedCarbs    Float   @default(0)
  plannedFat      Float   @default(0)

  // Relations
  cycle DietPlanCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  meals DietPlanMeal[]

  @@index([cycleId])
  @@map("diet_plan_cycle_days")
}

model TemplateCycle {
  id          String   @id @default(cuid())
  templateId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  template DietPlanTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  days     TemplateCycleDay[]

  @@index([templateId])
  @@map("template_cycles")
}

model TemplateCycleDay {
  id              String  @id @default(cuid())
  cycleId         String
  dayNumber       Int
  dayLabel        String
  description     String?
  isActive        Boolean @default(true)
  plannedCalories Int     @default(0)
  plannedProtein  Float   @default(0)
  plannedCarbs    Float   @default(0)
  plannedFat      Float   @default(0)

  // Relations
  cycle TemplateCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  meals DietPlanTemplateMeal[]

  @@index([cycleId])
  @@map("template_cycle_days")
}

enum EquivalencyType {
  PROTEIN
  CARB
  FAT
  CALORIE
}

enum FoodServingUnitType {
  GRAM
  CUP
  BOWL
  TBSP
  TSP
  PIECE
  SLICE
  SCOOP
  SERVING
}

enum FoodStatus {
  ACTIVE
  ARCHIVED
}

model FoodCategory {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  isSystem         Boolean   @default(false)
  parentCategoryId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  parentCategory FoodCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children       FoodCategory[] @relation("CategoryHierarchy")
  foods          FoodLibrary[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("food_categories")
}

model FoodTag {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  foodMappings FoodTagMapping[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("food_tags")
}

model FoodTagMapping {
  id        String   @id @default(cuid())
  foodId    String
  tagId     String
  createdAt DateTime @default(now())

  // Relations
  food FoodLibrary @relation(fields: [foodId], references: [id], onDelete: Cascade)
  tag  FoodTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([foodId, tagId])
  @@index([foodId])
  @@index([tagId])
  @@map("food_tag_mappings")
}

model FoodServing {
  id           String              @id @default(cuid())
  foodId       String
  name         String
  grams        Float
  unitType     FoodServingUnitType
  isDefault    Boolean             @default(false)
  displayOrder Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  food FoodLibrary @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
  @@map("food_servings")
}

model FoodEquivalent {
  id              String          @id @default(cuid())
  sourceFoodId    String
  targetFoodId    String
  equivalencyType EquivalencyType
  similarityScore Int             @default(100)
  createdAt       DateTime        @default(now())

  // Relations
  sourceFood FoodLibrary @relation("SourceEquivalent", fields: [sourceFoodId], references: [id], onDelete: Cascade)
  targetFood FoodLibrary @relation("TargetEquivalent", fields: [targetFoodId], references: [id], onDelete: Cascade)

  @@unique([sourceFoodId, targetFoodId, equivalencyType])
  @@index([sourceFoodId])
  @@index([targetFoodId])
  @@map("food_equivalents")
}

enum SwapStrategy {
  BALANCED_MATCH
  PROTEIN_MATCH
  CARB_MATCH
  FAT_MATCH
  CALORIE_MATCH
}

enum SwapScope {
  SINGLE_ITEM
  DIET_PLAN
  TEMPLATE
  CYCLE
  CYCLE_DAY
}

model MealSwapHistory {
  id             String       @id @default(cuid())
  tenantId       String
  mealItemId     String?
  originalFoodId String
  targetFoodId   String
  swapStrategy   SwapStrategy
  scope          SwapScope
  matchScore     Int?
  quantityBefore Float
  quantityAfter  Float
  performedBy    String
  createdAt      DateTime     @default(now())

  // Relations
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  user         User        @relation(fields: [performedBy], references: [id])
  originalFood FoodLibrary @relation("OriginalFoodSwaps", fields: [originalFoodId], references: [id])
  targetFood   FoodLibrary @relation("TargetFoodSwaps", fields: [targetFoodId], references: [id])

  @@index([tenantId])
  @@index([performedBy])
  @@index([originalFoodId])
  @@index([targetFoodId])
  @@map("meal_swap_histories")
}

// ─────────────────────────────────────────────────────────────────────────────
// FILE ASSETS (STORAGE MODULE)
// ─────────────────────────────────────────────────────────────────────────────

enum StorageProvider {
  CLOUDINARY
}

enum FileEntityType {
  TENANT
  USER
  CLIENT
  ASSESSMENT
  LAB_REPORT
  DIET_PLAN
  PACKAGE
  PROGRAM
  PROGRAM_CONTENT
  APPOINTMENT
  INVOICE
  WHATSAPP_MESSAGE
  WHATSAPP
  OTHER
}

enum FileVisibility {
  PUBLIC
  PROTECTED
  PRIVATE
}

enum FileStatus {
  ACTIVE
  DELETED
}

model FileAsset {
  id              String          @id @default(cuid())
  tenantId        String
  entityType      FileEntityType
  entityId        String
  folder          String
  publicId        String
  assetId         String? // Immutable asset ID (Cloudinary)
  version         Int             @default(1)
  isLatest        Boolean         @default(true)
  storageProvider StorageProvider @default(CLOUDINARY)
  resourceType    String
  fileName        String
  originalName    String
  mimeType        String
  extension       String
  fileSize        Int
  url             String
  secureUrl       String
  checksum        String?
  uploadedBy      String
  visibility      FileVisibility  @default(PRIVATE)
  status          FileStatus      @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  user            User           @relation("FileUploader", fields: [uploadedBy], references: [id])
  clientsAsAvatar   Client[]         @relation("ClientAvatar")
  vaultDocument     VaultDocument?
  whatsAppMessageId String?
  whatsAppMessage   WhatsAppMessage? @relation(fields: [whatsAppMessageId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([status])
  @@index([visibility])
  @@map("file_assets")
}

model VaultDocument {
  id          String  @id @default(cuid())
  tenantId    String
  clientId    String
  assetId     String  @unique
  category    String // Enums: BLOODWORK, CONSENT_FORM, DIET_HISTORY, LIFESTYLE_FITNESS, GENERAL
  description String? @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  asset      FileAsset         @relation(fields: [assetId], references: [id])
  labResults ClientLabResult[]

  @@index([tenantId, clientId, deletedAt])
  @@map("vault_documents")
}

model WhatsAppConnection {
  id String @id @default(cuid())

  tenantId String @unique

  status WhatsAppConnectionStatus @default(NOT_CONFIGURED)

  provider           String? @default("WHATSAPP")
  tokenType          String?
  scope              String?
  metaBusinessId     String?

  wabaId             String?
  phoneNumberId      String?
  businessAccountId  String?

  displayPhoneNumber String?
  verifiedName       String?

  accessToken        String?
  refreshToken       String?

  tokenExpiresAt     DateTime?

  webhookVerified    Boolean @default(false)

  connectedAt        DateTime?
  lastSyncAt         DateTime?
  
  lastValidatedAt            DateTime?
  lastSuccessfulValidationAt DateTime?
  lastError                  String?
  lastErrorCode              String?
  lastErrorAt                DateTime?
  validationAttempts         Int      @default(0)
  credentialFingerprint      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("whatsapp_connections")
}

enum WhatsAppSenderType {
  USER
  SYSTEM
  CLIENT
}

enum WhatsAppMessageSource {
  MANUAL
  AUTOMATION
  AI
  API
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  TEMPLATE
  DOCUMENT
  IMAGE
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  VOICE
  STICKER
  REACTION
  SYSTEM
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConversation {
  id                        String                @id @default(cuid())
  tenantId                  String
  clientId                  String
  
  optInStatus               Boolean               @default(false)
  optInCapturedAt           DateTime?
  
  lastMessageId             String?
  lastMessageText           String?               @db.VarChar(500)
  lastMessageAt             DateTime?
  unreadCount               Int                   @default(0)
  
  isArchived                Boolean               @default(false)
  isMuted                   Boolean               @default(false)
  
  conversationStartedAt     DateTime?
  lastInboundAt             DateTime?
  lastOutboundAt            DateTime?
  lastClientMessageAt       DateTime?
  lastPractitionerMessageAt DateTime?
  
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  
  tenant                    Tenant                @relation(fields: [tenantId], references: [id])
  client                    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages                  WhatsAppMessage[]

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  tenantId          String
  conversationId    String
  metaMessageId     String?                  @unique
  
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  status            WhatsAppMessageStatus    @default(QUEUED)
  senderType        WhatsAppSenderType
  source            WhatsAppMessageSource    @default(MANUAL)
  
  body              String?                  @db.Text
  templateName      String?
  templateLanguage  String?                  @db.VarChar(10)
  
  mediaMimeType     String?                  @db.VarChar(100)
  mediaSize         Int?
  
  mediaUrl                String?                  @db.Text
  mediaFileName           String?                  @db.VarChar(255)
  mediaWidth              Int?
  mediaHeight             Int?
  mediaDurationSeconds    Int?
  storageFileId           String?
  replyToMessageId        String?
  replyToMetaMessageId    String?
  replyPreviewText        String?                  @db.Text
  locationLatitude        Float?
  locationLongitude       Float?
  locationName            String?                  @db.VarChar(255)
  locationAddress         String?                  @db.Text
  contactName             String?                  @db.VarChar(255)
  contactPhones           Json?
  contactPayload          Json?
  interactivePayload      Json?
  previewText             String?                  @db.VarChar(500)
  
  senderUserId      String?
  senderRole        Role?
  senderName        String?                  @db.VarChar(100)
  senderPhone       String?                  @db.VarChar(30)
  createdByUserId   String?
  
  errorText         String?                  @db.Text
  lastErrorCode     String?                  @db.VarChar(50)
  
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  
  deletedAt         DateTime?
  deletedByUserId   String?
  deleteSource      String?                  @db.VarChar(20)
  deletedBy         String?                  @db.VarChar(100)
  
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  conversation      WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser        User?                    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments       FileAsset[]
  reactions         WhatsAppReaction[]

  @@index([tenantId])
  @@index([conversationId])
  @@index([metaMessageId])
  @@index([senderUserId])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppReaction {
  id              String   @id @default(cuid())
  tenantId        String
  messageId       String
  metaMessageId   String?  @db.VarChar(100)
  senderPhone     String   @db.VarChar(30)
  senderName      String?  @db.VarChar(100)
  emoji           String   @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  message         WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderPhone])
  @@index([tenantId])
  @@index([messageId])
  @@map("whatsapp_reactions")
}

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  priority   String   @default("NORMAL")
  actionUrl  String?
  metadata   Json?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, isArchived])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  browserNotifications Boolean  @default(true)
  inAppNotifications   Boolean  @default(true)
  soundNotifications   Boolean  @default(true)
  soundVolume          Int      @default(80)
  soundId              String   @default("message-default")
  categories           Json?    // Kept for backward compatibility migration
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIET PLAN AUTOMATION & REMINDER INFRASTRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model DietPlanAutomation {
  id          String           @id @default(cuid())
  tenantId    String
  clientId    String
  dietPlanId  String
  status      AutomationStatus @default(ACTIVE)
  activatedAt DateTime?
  activatedBy String?
  startDate   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, status])
  @@index([tenantId, status])
  @@map("diet_plan_automations")
}

model ReminderJob {
  id           String            @id @default(cuid())
  tenantId     String
  clientId     String
  dietPlanId   String
  jobType      ReminderJobType
  scheduledFor DateTime
  timezone     String
  status       ReminderJobStatus @default(PENDING)
  templateKey  String?
  mealType     String?
  executedAt   DateTime?
  errorText    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([status, scheduledFor])
  @@index([tenantId, status])
  @@map("reminder_jobs")
}


