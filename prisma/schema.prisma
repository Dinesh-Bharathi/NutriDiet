generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Tenant {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  plan                        TenantPlan                   @default(FREE_TRIAL)
  status                      TenantStatus                 @default(TRIAL)
  email                       String?
  phone                       String?
  address                     String?
  logoUrl                     String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?
  themeId                     String?
  countryCode                 String?
  currencyCode                String                       @default("USD")
  locale                      String                       @default("en-US")
  measurementSystem           MeasurementSystem            @default(METRIC)
  timezone                    String                       @default("UTC")
  pdfTemplateConfig           Json?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  country                     String?
  postalCode                  String?
  practiceEmail               String?
  practicePhone               String?
  state                       String?
  reminderConfig              Json?
  assessmentSectionStatuses   AssessmentSectionStatus[]
  assessmentSnapshots         AssessmentSnapshot[]
  assessments                 Assessment[]
  clientAllergies             ClientAllergy[]
  clientAnthropometricRecords ClientAnthropometricRecord[]
  clientCheckIns              ClientCheckIn[]
  clientClinicalProfiles      ClientClinicalProfile[]
  complianceEvents            ClientComplianceEvent[]
  clientConditions            ClientCondition[]
  clientDigestiveIssues       ClientDigestiveIssue[]
  clientGoalProfiles          ClientGoalProfile[]
  clientLabResults            ClientLabResult[]
  clientLifestyleProfiles     ClientLifestyleProfile[]
  clientMedications           ClientMedication[]
  clientRiskFlags             ClientRiskFlag[]
  clientSupplements           ClientSupplement[]
  clients                     Client[]
  complianceDailySummaries    ComplianceDailySummary[]
  dietPlanAutomations         DietPlanAutomation[]
  dietPlanTemplates           DietPlanTemplate[]
  dietPlans                   DietPlan[]
  fileAssets                  FileAsset[]
  invoices                    Invoice[]
  foodCategories              FoodCategory[]
  foodLibrary                 FoodLibrary[]
  foodTags                    FoodTag[]
  labMarkerDefinitions        LabMarkerDefinition[]
  mealSwapHistories           MealSwapHistory[]
  notifications               Notification[]
  payments                    Payment[]
  reminderExecutions          ReminderExecution[]
  reminderJobs                ReminderJob[]
  reminderTemplates           ReminderTemplate[]
  subscriptions               Subscription[]
  users                       User[]
  vaultDocuments              VaultDocument[]
  whatsAppConnection          WhatsAppConnection?
  whatsAppConversations       WhatsAppConversation[]
  whatsAppMessages            WhatsAppMessage[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id                           String                    @id @default(cuid())
  tenantId                     String
  email                        String
  passwordHash                 String
  firstName                    String
  lastName                     String
  role                         Role                      @default(DIETITIAN)
  status                       UserStatus                @default(PENDING)
  phone                        String?
  avatarUrl                    String?
  emailVerifiedAt              DateTime?
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  deletedAt                    DateTime?
  completedAssessmentSections  AssessmentSectionStatus[] @relation("AssessmentSectionCompletedBy")
  generatedAssessmentSnapshots AssessmentSnapshot[]      @relation("AssessmentSnapshotGenerator")
  assessments                  Assessment[]
  reviewedCheckIns             ClientCheckIn[]
  createdClinicalProfiles      ClientClinicalProfile[]   @relation("ClinicalProfileCreator")
  generatedRiskFlags           ClientRiskFlag[]          @relation("RiskFlagGenerator")
  clients                      Client[]                  @relation("AssignedDietitian")
  dietPlanTemplates            DietPlanTemplate[]
  dietPlans                    DietPlan[]
  uploadedFiles                FileAsset[]               @relation("FileUploader")
  mealSwapHistories            MealSwapHistory[]
  notificationPreference       NotificationPreference?
  notifications                Notification[]
  refreshTokens                RefreshToken[]
  tenant                       Tenant                    @relation(fields: [tenantId], references: [id])
  whatsAppMessages             WhatsAppMessage[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@map("users")
}

model Client {
  id                        String                       @id @default(cuid())
  tenantId                  String
  dietitianId               String?
  firstName                 String
  lastName                  String
  email                     String?
  phone                     String?
  gender                    Gender?
  dateOfBirth               DateTime?
  notes                     String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  deletedAt                 DateTime?
  onboardingStatus          OnboardingStatus             @default(PENDING)
  status                    ClientStatus                 @default(ACTIVE)
  avatarAssetId             String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  country                   String?
  locale                    String?
  remindersEnabled          Boolean                      @default(true)
  state                     String?
  timezone                  String?
  assessmentSectionStatuses AssessmentSectionStatus[]
  assessmentSnapshots       AssessmentSnapshot[]
  assessments               Assessment[]
  allergyRecords            ClientAllergy[]
  anthropometricRecords     ClientAnthropometricRecord[]
  checkIns                  ClientCheckIn[]
  clinicalProfile           ClientClinicalProfile?
  complianceEvents          ClientComplianceEvent[]
  conditions                ClientCondition[]
  digestiveIssueRecords     ClientDigestiveIssue[]
  goalProfiles              ClientGoalProfile[]
  labResults                ClientLabResult[]
  lifestyleProfile          ClientLifestyleProfile?
  medicationRecords         ClientMedication[]
  riskFlags                 ClientRiskFlag[]
  supplementRecords         ClientSupplement[]
  avatarAsset               FileAsset?                   @relation("ClientAvatar", fields: [avatarAssetId], references: [id])
  dietitian                 User?                        @relation("AssignedDietitian", fields: [dietitianId], references: [id])
  tenant                    Tenant                       @relation(fields: [tenantId], references: [id])
  complianceDailySummaries  ComplianceDailySummary[]
  dietPlanAutomations       DietPlanAutomation[]
  dietPlans                 DietPlan[]
  reminderJobs              ReminderJob[]
  vaultDocuments            VaultDocument[]
  whatsAppConversations     WhatsAppConversation[]

  @@index([tenantId])
  @@index([tenantId, dietitianId])
  @@index([tenantId, email])
  @@map("clients")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Assessment {
  id                    String                       @id @default(cuid())
  tenantId              String
  clientId              String
  createdBy             String
  title                 String
  assessmentDate        DateTime
  heightCm              Float?
  weightKg              Float?
  bmi                   Float?
  goal                  String?
  activityLevel         ActivityLevel?
  waterIntakeLiters     Float?
  sleepHours            Float?
  medicalConditions     String?
  allergies             String?
  medications           String?
  foodPreferences       String?
  foodRestrictions      String?
  notes                 String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deletedAt             DateTime?
  goalType              ClientGoalType?
  sectionStatuses       AssessmentSectionStatus[]
  snapshots             AssessmentSnapshot[]
  client                Client                       @relation(fields: [clientId], references: [id])
  creator               User                         @relation(fields: [createdBy], references: [id])
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  allergyRecords        ClientAllergy[]
  anthropometricRecords ClientAnthropometricRecord[]
  clinicalProfiles      ClientClinicalProfile[]      @relation("LatestAssessmentProfile")
  conditions            ClientCondition[]
  digestiveIssueRecords ClientDigestiveIssue[]
  goalProfiles          ClientGoalProfile[]
  labResults            ClientLabResult[]
  lifestyleProfiles     ClientLifestyleProfile[]
  medicationRecords     ClientMedication[]
  riskFlags             ClientRiskFlag[]
  supplementRecords     ClientSupplement[]
  dietPlans             DietPlan[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("assessments")
}

model ClientClinicalProfile {
  id                    String                       @id @default(cuid())
  tenantId              String
  clientId              String                       @unique
  latestAssessmentId    String?
  createdById           String?
  summaryNotes          String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deletedAt             DateTime?
  sectionStatuses       AssessmentSectionStatus[]
  snapshots             AssessmentSnapshot[]
  allergies             ClientAllergy[]
  anthropometricRecords ClientAnthropometricRecord[]
  client                Client                       @relation(fields: [clientId], references: [id])
  createdBy             User?                        @relation("ClinicalProfileCreator", fields: [createdById], references: [id])
  latestAssessment      Assessment?                  @relation("LatestAssessmentProfile", fields: [latestAssessmentId], references: [id])
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  conditions            ClientCondition[]
  digestiveIssues       ClientDigestiveIssue[]
  goalProfiles          ClientGoalProfile[]
  labResults            ClientLabResult[]
  lifestyleProfile      ClientLifestyleProfile?
  medications           ClientMedication[]
  riskFlags             ClientRiskFlag[]
  supplements           ClientSupplement[]

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@index([latestAssessmentId])
  @@map("client_clinical_profiles")
}

model AssessmentSectionStatus {
  id            String                          @id @default(cuid())
  tenantId      String
  clientId      String
  profileId     String
  assessmentId  String?
  section       AssessmentSectionType
  status        AssessmentSectionWorkflowStatus @default(DRAFT)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  deletedAt     DateTime?
  assessment    Assessment?                     @relation(fields: [assessmentId], references: [id])
  client        Client                          @relation(fields: [clientId], references: [id])
  completedBy   User?                           @relation("AssessmentSectionCompletedBy", fields: [completedById], references: [id])
  profile       ClientClinicalProfile           @relation(fields: [profileId], references: [id])
  tenant        Tenant                          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, profileId, section])
  @@index([tenantId, clientId])
  @@index([assessmentId])
  @@map("assessment_section_statuses")
}

model ClientAnthropometricRecord {
  id             String                @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  measuredAt     DateTime              @default(now())
  heightCm       Float?
  weightKg       Float?
  bmi            Float?
  bodyFatPercent Float?
  leanMassKg     Float?
  waistCm        Float?
  hipCm          Float?
  chestCm        Float?
  armCm          Float?
  thighCm        Float?
  neckCm         Float?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  assessment     Assessment?           @relation(fields: [assessmentId], references: [id])
  client         Client                @relation(fields: [clientId], references: [id])
  profile        ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@index([measuredAt])
  @@map("client_anthropometric_records")
}

model ClientCondition {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  status       String?
  diagnosedAt  DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assessment   Assessment?           @relation(fields: [assessmentId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  profile      ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_conditions")
}

model ClientAllergy {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  allergen     String
  reaction     String?
  severity     String?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assessment   Assessment?           @relation(fields: [assessmentId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  profile      ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, allergen])
  @@index([profileId])
  @@map("client_allergies")
}

model ClientMedication {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  dosage       String?
  frequency    String?
  startedAt    DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assessment   Assessment?           @relation(fields: [assessmentId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  profile      ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_medications")
}

model ClientSupplement {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  dosage       String?
  frequency    String?
  startedAt    DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assessment   Assessment?           @relation(fields: [assessmentId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  profile      ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_supplements")
}

model ClientDigestiveIssue {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String
  profileId    String
  assessmentId String?
  name         String
  severity     String?
  triggers     String?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assessment   Assessment?           @relation(fields: [assessmentId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  profile      ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, name])
  @@index([profileId])
  @@map("client_digestive_issues")
}

model ClientLifestyleProfile {
  id                String                @id @default(cuid())
  tenantId          String
  clientId          String                @unique
  profileId         String                @unique
  assessmentId      String?
  occupation        String?
  workSchedule      String?
  sleepHours        Float?
  stressLevel       Int?
  hydrationLiters   Float?
  trainingFrequency String?
  activityLevel     ActivityLevel?
  mealTiming        String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  assessment        Assessment?           @relation(fields: [assessmentId], references: [id])
  client            Client                @relation(fields: [clientId], references: [id])
  profile           ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant            Tenant                @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clientId])
  @@index([tenantId, clientId])
  @@index([assessmentId])
  @@map("client_lifestyle_profiles")
}

model ClientGoalProfile {
  id             String                @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  goalType       ClientGoalType
  targetWeightKg Float?
  targetDate     DateTime?
  status         ClientGoalStatus      @default(ACTIVE)
  notes          String?
  versionNumber  Int                   @default(1)
  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  assessment     Assessment?           @relation(fields: [assessmentId], references: [id])
  client         Client                @relation(fields: [clientId], references: [id])
  profile        ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  dietPlans      DietPlan[]

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([status])
  @@map("client_goal_profiles")
}

model LabMarkerDefinition {
  id             String            @id @default(cuid())
  tenantId       String?
  markerKey      String
  name           String
  category       String?
  defaultUnit    String?
  referenceRange Json?
  sortOrder      Int               @default(1)
  isSystem       Boolean           @default(false)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  labResults     ClientLabResult[]
  tenant         Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, markerKey])
  @@index([tenantId])
  @@index([markerKey])
  @@index([isSystem, isActive])
  @@map("lab_marker_definitions")
}

model ClientLabResult {
  id                     String                @id @default(cuid())
  tenantId               String
  clientId               String
  profileId              String
  assessmentId           String?
  markerDefinitionId     String?
  markerKey              String
  markerName             String
  valueNumeric           Float?
  valueText              String?
  unit                   String?
  collectedDate          DateTime?
  resultDate             DateTime?
  referenceRangeSnapshot Json?
  isAbnormal             Boolean               @default(false)
  severity               LabResultSeverity?
  flagReason             String?
  source                 String?
  notes                  String?
  metadata               Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  documentPageReference  String?
  vaultDocumentId        String?
  assessment             Assessment?           @relation(fields: [assessmentId], references: [id])
  client                 Client                @relation(fields: [clientId], references: [id])
  markerDefinition       LabMarkerDefinition?  @relation(fields: [markerDefinitionId], references: [id])
  profile                ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  vaultDocument          VaultDocument?        @relation(fields: [vaultDocumentId], references: [id])

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@index([markerDefinitionId])
  @@index([markerKey])
  @@index([resultDate])
  @@index([isAbnormal])
  @@index([vaultDocumentId])
  @@map("client_lab_results")
}

model ClientRiskFlag {
  id             String                @id @default(cuid())
  tenantId       String
  clientId       String
  profileId      String
  assessmentId   String?
  flagType       String
  severity       RiskFlagSeverity
  reason         String
  sourceDomain   String?
  sourceRecordId String?
  status         RiskFlagStatus        @default(ACTIVE)
  generatedById  String?
  generatedAt    DateTime              @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  assessment     Assessment?           @relation(fields: [assessmentId], references: [id])
  client         Client                @relation(fields: [clientId], references: [id])
  generatedBy    User?                 @relation("RiskFlagGenerator", fields: [generatedById], references: [id])
  profile        ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([status])
  @@index([severity])
  @@index([sourceDomain, sourceRecordId])
  @@map("client_risk_flags")
}

model AssessmentSnapshot {
  id              String                @id @default(cuid())
  tenantId        String
  clientId        String
  profileId       String
  assessmentId    String?
  version         Int
  snapshot        Json
  sourceUpdatedAt DateTime?
  generatedById   String?
  generatedAt     DateTime              @default(now())
  createdAt       DateTime              @default(now())
  assessment      Assessment?           @relation(fields: [assessmentId], references: [id])
  client          Client                @relation(fields: [clientId], references: [id])
  generatedBy     User?                 @relation("AssessmentSnapshotGenerator", fields: [generatedById], references: [id])
  profile         ClientClinicalProfile @relation(fields: [profileId], references: [id])
  tenant          Tenant                @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clientId, version])
  @@index([tenantId, clientId])
  @@index([profileId])
  @@index([assessmentId])
  @@map("assessment_snapshots")
}

model DietPlan {
  id              String               @id @default(cuid())
  tenantId        String
  clientId        String
  assessmentId    String?
  title           String
  description     String?
  dailyCalories   Int?
  proteinGrams    Float?
  carbGrams       Float?
  fatGrams        Float?
  startDate       DateTime?
  endDate         DateTime?
  status          DietPlanStatus       @default(DRAFT)
  createdBy       String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  totalCalories   Int                  @default(0)
  totalCarbs      Float                @default(0)
  totalFat        Float                @default(0)
  totalProtein    Float                @default(0)
  versionNumber   Int                  @default(1)
  cycleStartDate  DateTime?
  goalProfileId   String?
  hydration       String?
  instructions    String?
  lifestyleAdvice String?
  mealPrepNotes   String?
  recommendations String?
  supplementNotes String?
  checkIns        ClientCheckIn[]
  automations     DietPlanAutomation[]
  cycles          DietPlanCycle[]
  meals           DietPlanMeal[]
  assessment      Assessment?          @relation(fields: [assessmentId], references: [id])
  client          Client               @relation(fields: [clientId], references: [id])
  creator         User                 @relation(fields: [createdBy], references: [id])
  goalProfile     ClientGoalProfile?   @relation(fields: [goalProfileId], references: [id])
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  reminderJobs    ReminderJob[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("diet_plans")
}

model DietPlanMeal {
  id         String             @id @default(cuid())
  dietPlanId String
  name       MealType
  mealOrder  Int
  mealTime   String?
  notes      String?
  cycleDayId String?
  items      DietPlanMealItem[]
  cycleDay   DietPlanCycleDay?  @relation(fields: [cycleDayId], references: [id], onDelete: Cascade)
  dietPlan   DietPlan           @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  @@index([dietPlanId])
  @@index([cycleDayId])
  @@map("diet_plan_meals")
}

model DietPlanMealItem {
  id            String         @id @default(cuid())
  mealId        String
  foodName      String
  quantity      Float
  unit          String
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  notes         String?
  foodLibraryId String?
  sourceType    FoodSourceType @default(CUSTOM)
  foodLibrary   FoodLibrary?   @relation(fields: [foodLibraryId], references: [id])
  meal          DietPlanMeal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([foodLibraryId])
  @@map("diet_plan_meal_items")
}

model FoodLibrary {
  id                String                     @id @default(cuid())
  tenantId          String
  foodName          String
  defaultQuantity   Float
  defaultUnit       String
  servingSize       Float
  servingUnit       String
  calories          Float?
  protein           Float?
  carbs             Float?
  fat               Float?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?
  brandName         String?
  categoryId        String?
  commonName        String?
  searchKeywords    String?
  status            FoodStatus                 @default(ACTIVE)
  isSystem          Boolean                    @default(false)
  mealItems         DietPlanMealItem[]
  templateMealItems DietPlanTemplateMealItem[]
  sourceEquivalents FoodEquivalent[]           @relation("SourceEquivalent")
  targetEquivalents FoodEquivalent[]           @relation("TargetEquivalent")
  category          FoodCategory?              @relation(fields: [categoryId], references: [id])
  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  servings          FoodServing[]
  tagMappings       FoodTagMapping[]
