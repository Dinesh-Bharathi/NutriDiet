// prisma/schema.prisma
// ─────────────────────────────────────────────────────────────────────────────
// Prisma data model for the Nutri-Diet multi-tenant SaaS platform.
// Phase 1 + 2: Tenant, User, Client, RefreshToken.
//
// Rules enforced here:
//  - Every entity has a UUID primary key (cuid() used for URL-safety + performance)
//  - Every entity that belongs to a tenant carries a tenantId FK
//  - Soft-delete via deletedAt (no hard deletes on business data)
//  - Timestamps (createdAt, updatedAt) on every table
//  - All string IDs are generated server-side — never trust client-supplied IDs
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  DIETITIAN
  ASSISTANT
  CLIENT
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// Top-level multi-tenancy entity. Every business (clinic, coach, dietitian)
// is a Tenant. All data queries MUST include tenantId in the WHERE clause.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(FREE)
  status    TenantStatus @default(TRIAL)

  // Optional contact info
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  themeId   String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  users       User[]
  clients     Client[]
  assessments Assessment[]
  dietPlans   DietPlan[]
  foodLibrary FoodLibrary[]
  dietPlanTemplates DietPlanTemplate[]
  clientCheckIns ClientCheckIn[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Platform users (staff side): OWNER, ADMIN, DIETITIAN, ASSISTANT.
// CLIENT role users have a corresponding Client record.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(DIETITIAN)
  status       UserStatus @default(PENDING)
  phone        String?
  avatarUrl    String?

  // Security
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  clients           Client[]           @relation("AssignedDietitian")
  refreshTokens     RefreshToken[]
  assessments       Assessment[]
  dietPlans         DietPlan[]
  dietPlanTemplates DietPlanTemplate[]
  reviewedCheckIns ClientCheckIn[]

  // Compound unique: email must be unique within a tenant (not globally)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT
// End-users of the wellness service. Can have a linked User account (for
// portal access) or exist as a practitioner-managed record only.
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id           String  @id @default(cuid())
  tenantId     String
  dietitianId  String?  // Assigned practitioner (User with DIETITIAN role)

  // Identity
  firstName    String
  lastName     String
  email        String?
  phone        String?
  gender       Gender?
  dateOfBirth  DateTime?
  avatarUrl    String?

  // Health context (non-PHI; PHI goes in a separate encrypted table in Phase 2)
  notes        String?

  status           ClientStatus      @default(ACTIVE)
  onboardingStatus OnboardingStatus  @default(PENDING)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  dietitian   User?        @relation("AssignedDietitian", fields: [dietitianId], references: [id])
  assessments Assessment[]
  dietPlans   DietPlan[]
  checkIns    ClientCheckIn[]

  @@index([tenantId])
  @@index([tenantId, dietitianId])
  @@index([tenantId, email])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFRESH TOKEN
// Stores hashed refresh tokens for secure rotation.
// Raw token is sent to client; only SHA-256 hash lives in DB.
// Token reuse triggers immediate revocation of all user sessions.
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique  // SHA-256(rawToken) — NEVER the raw token
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT
// Clinical assessment records.
// ─────────────────────────────────────────────────────────────────────────────

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

model Assessment {
  id             String        @id @default(cuid())
  tenantId       String
  clientId       String
  createdBy      String

  title          String
  assessmentDate DateTime

  heightCm       Float?
  weightKg       Float?
  bmi            Float?

  goal           String?

  activityLevel  ActivityLevel?
  waterIntakeLiters Float?

  sleepHours     Float?

  medicalConditions String?
  allergies         String?
  medications       String?

  foodPreferences   String?
  foodRestrictions  String?

  notes             String?

  // Timestamps
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  client         Client        @relation(fields: [clientId], references: [id])
  creator        User          @relation(fields: [createdBy], references: [id])
  dietPlans      DietPlan[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("assessments")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIET PLAN
// ─────────────────────────────────────────────────────────────────────────────

enum DietPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MealType {
  BREAKFAST
  MID_MORNING
  LUNCH
  EVENING_SNACK
  DINNER
  BEDTIME
}

model DietPlan {
  id           String  @id @default(cuid())
  tenantId     String
  clientId     String
  assessmentId String?

  title        String
  description  String?
  goal         String?

  dailyCalories Int?
  proteinGrams  Float?
  carbGrams     Float?
  fatGrams      Float?

  // Aggregated macros
  totalCalories Int   @default(0)
  totalProtein  Float @default(0)
  totalCarbs    Float @default(0)
  totalFat      Float @default(0)

  // Versioning
  versionNumber Int @default(1)

  startDate DateTime?
  endDate   DateTime?

  status DietPlanStatus @default(DRAFT)

  createdBy String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id])
  assessment Assessment?   @relation(fields: [assessmentId], references: [id])
  creator    User          @relation(fields: [createdBy], references: [id])
  meals      DietPlanMeal[]
  checkIns   ClientCheckIn[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@map("diet_plans")
}

model DietPlanMeal {
  id         String   @id @default(cuid())
  dietPlanId String
  name       MealType
  mealOrder  Int
  mealTime   String?
  notes      String?

  // Relations
  dietPlan DietPlan              @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  items    DietPlanMealItem[]

  @@index([dietPlanId])
  @@map("diet_plan_meals")
}


model DietPlanMealItem {
  id            String         @id @default(cuid())
  mealId        String
  foodLibraryId String?
  foodName      String
  sourceType    FoodSourceType @default(CUSTOM)
  quantity      Float
  unit          String
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  notes         String?

  // Relations
  meal        DietPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLibrary FoodLibrary? @relation(fields: [foodLibraryId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([foodLibraryId])
  @@map("diet_plan_meal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// FOOD LIBRARY
// ─────────────────────────────────────────────────────────────────────────────

enum FoodSourceType {
  CUSTOM
  SYSTEM
}

model FoodLibrary {
  id                String                     @id @default(cuid())
  tenantId          String
  foodName          String
  sourceType        FoodSourceType             @default(CUSTOM)
  defaultQuantity   Float
  defaultUnit       String
  servingSize       Float
  servingUnit       String
  calories          Float?
  protein           Float?
  carbs             Float?
  fat               Float?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?

  // Relations
  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  mealItems         DietPlanMealItem[]
  templateMealItems DietPlanTemplateMealItem[]

  @@index([tenantId])
  @@index([tenantId, foodName])
  @@map("food_library")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIET PLAN TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model DietPlanTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  goal           String?
  dailyCalories  Int?
  proteinGrams   Float?
  carbGrams      Float?
  fatGrams       Float?

  // Aggregated macros
  totalCalories  Int      @default(0)
  totalProtein   Float    @default(0)
  totalCarbs     Float    @default(0)
  totalFat       Float    @default(0)

  isPublic       Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  creator        User     @relation(fields: [createdBy], references: [id])
  meals          DietPlanTemplateMeal[]

  @@index([tenantId])
  @@map("diet_plan_templates")
}

model DietPlanTemplateMeal {
  id         String   @id @default(cuid())
  templateId String
  name       MealType
  mealOrder  Int
  mealTime   String?
  notes      String?

  // Relations
  template   DietPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items      DietPlanTemplateMealItem[]

  @@index([templateId])
  @@map("diet_plan_template_meals")
}

model DietPlanTemplateMealItem {
  id            String               @id @default(cuid())
  mealId        String
  foodLibraryId String?
  foodName      String
  sourceType    FoodSourceType       @default(CUSTOM)
  quantity      Float
  unit          String
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  notes         String?

  // Relations
  meal        DietPlanTemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodLibrary FoodLibrary?         @relation(fields: [foodLibraryId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([foodLibraryId])
  @@map("diet_plan_template_meal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT CHECK-INS
// ─────────────────────────────────────────────────────────────────────────────

enum CheckInStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

model ClientCheckIn {
  id                String        @id @default(cuid())
  tenantId          String
  clientId          String
  dietPlanId        String?
  
  checkInDate       DateTime
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  
  status            CheckInStatus @default(PENDING)
  requiresFollowUp  Boolean       @default(false)

  // Weight & Measurements
  weightKg          Float?
  waistCm           Float?
  hipCm             Float?
  chestCm           Float?
  armCm             Float?
  thighCm           Float?

  // Lifestyle
  waterIntakeLiters Float?
  sleepHours        Float?
  exerciseDays      Int?

  // Self Assessment
  energyLevel       Int?
  stressLevel       Int?
  moodLevel         Int?
  planAdherence     Int?
  adherenceNotes    String?

  // Notes
  clientNotes       String?
  practitionerNotes String?

  // Audit
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  client            Client        @relation(fields: [clientId], references: [id])
  dietPlan          DietPlan?     @relation(fields: [dietPlanId], references: [id], onDelete: SetNull)
  reviewer          User?         @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tenantId])
  @@index([status])
  @@index([submittedAt])
  @@index([checkInDate])
  @@index([clientId, checkInDate])
  @@map("client_check_ins")
}

