# ============================================================
# NUTRI-DIET BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── APPLICATION ────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL=postgresql://nutridiet_user:your_password@localhost:5432/nutridiet_db?schema=public

# ─── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_a_long_random_refresh_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── REDIS ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password
REDIS_DB=0
REDIS_URL=redis://:change_this_to_a_secure_redis_password@localhost:6379/0

# ─── CORS ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── LOGGING ────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── RATE LIMITING ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── BCRYPT ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your_aes_256_encryption_key_at_least_32_characters

# ─── META GRAPH API ──────────────────────────────────────────
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v19.0

# ─── CLOUDFLARE R2 ──────────────────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_URL=https://pub-your-domain.r2.dev
