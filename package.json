{
  "name": "nutri-diet-backend",
  "version": "1.0.0",
  "description": "Enterprise multi-tenant SaaS backend for nutritionists, dietitians, and wellness businesses",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "lint": "eslint src/ --ext .js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --detectOpenHandles",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^5.13.0",
    "argon2": "^0.44.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.9.0",
    "currency-codes": "^2.2.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.3.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.6",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "puppeteer": "25.1.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "tmp": "^0.2.7",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.13.0",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "nutrition",
    "dietitian",
    "wellness",
    "enterprise",
    "nodejs",
    "expressjs"
  ],
  "author": "Nutri-Diet Engineering",
  "license": "UNLICENSED",
  "private": true
}
